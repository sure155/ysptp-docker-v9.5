# 复制为 .env 后修改：  cp .env.example .env
# 注释必须单独成行（不要写在值的后面）。

# 【必填】访问口令，8~64 位的字母/数字/下划线/连字符。生成：openssl rand -hex 16
# 订阅地址会变成 http://IP:8767/<口令>/all.m3u ；不知道口令的人什么也访问不到。
YSP_TOKEN=

# 宿主机监听地址和端口。用 Caddy/Nginx 反代时改为 127.0.0.1
HOST_BIND=0.0.0.0
HOST_PORT=8767

# 对外访问的基础地址（有域名 / 反代 / https 时填，末尾不要斜杠），例：https://tv.example.com
# 留空则按请求里的 Host 自动生成。
YSP_PUBLIC_URL=

# 分片是否经 VPS 中转：0=播放器直连央视 CDN（VPS 几乎不耗流量，默认）；1=经 VPS 中转
# 客户端在境外 / 直连被拒 / 需要 https 时再改成 1。详见 README。
YSP_PROXY_SEGMENTS=0
# 中转模式下的分片内存缓存（MB）
YSP_CACHE_MB=64
# 中转模式额外放行的 CDN 域名后缀（逗号分隔），一般不用填
YSP_SEG_ALLOW_EXTRA=

# 不想提供的频道（逗号分隔 slug），例：不要 4K/8K 频道 → cctv4k,cctv8k,cctv164k
YSP_EXCLUDE_CHANNELS=

# 构建用的基础镜像。国内 VPS 拉 Docker Hub 慢时改为：
# PY_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
PY_IMAGE=python:3.12-slim
